{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行扩展（Extension Development Host）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: esbuild",
      "console": "integratedTerminal"
    }
  ]
}
