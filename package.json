{
  "name": "xinghan-upload",
  "displayName": "星瀚助手",
  "description": "在 Cursor/VSCode 中一键上传代码到星瀚控制器 (ESP32 MicroPython)，上传逻辑由 Python 脚本 wired_uploader.py 完成",
  "version": "0.15.1",
  "publisher": "XuChang0327",
  "icon": "logo.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "xinghan.submenu",
        "label": "星瀚助手"
      }
    ],
    "commands": [
      {
        "command": "xinghan.runOnDevice",
        "title": "运行"
      },
      {
        "command": "xinghan.stopRunOnDevice",
        "title": "停止"
      },
      {
        "command": "xinghan.toggleRunOnDevice",
        "title": "星瀚: 切换运行状态"
      },
      {
        "command": "xinghan.upload",
        "title": "上传"
      },
      {
        "command": "xinghan.uploadAndRun",
        "title": "上传运行"
      },
      {
        "command": "xinghan.connectBluetooth",
        "title": "星瀚: 蓝牙连接"
      },
      {
        "command": "xinghan.toggleBluetooth",
        "title": "星瀚: 切换蓝牙连接"
      },
      {
        "command": "xinghan.disconnectBluetooth",
        "title": "星瀚: 蓝牙断开"
      },
      {
        "command": "xinghan.deleteFileFromTree",
        "title": "删除"
      },
      {
        "command": "xinghan.disconnectRepl",
        "title": "星瀚: REPL断开"
      },
      {
        "command": "xinghan.toggleRepl",
        "title": "星瀚: 切换 REPL连接"
      },
      {
        "command": "xinghan.refreshConnectionStatus",
        "title": "刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "xinghan.refreshDeviceFiles",
        "title": "刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "xinghan.copyConnectionDeviceId",
        "title": "复制设备编号"
      },
      {
        "command": "xinghan.copyConnectionPort",
        "title": "复制串口信息"
      },
      {
        "command": "xinghan.openDeviceFile",
        "title": "星瀚: 打开设备文件"
      },
      {
        "command": "xinghan.deleteFile",
        "title": "星瀚: 删除设备文件"
      },
      {
        "command": "xinghan.connectWifi",
        "title": "星瀚: WiFi连接"
      },
      {
        "command": "xinghan.selectPortAndRepl",
        "title": "星瀚: REPL连接"
      },
      {
        "command": "xinghan.renameDeviceFileFromTree",
        "title": "重命名"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "xinghan.refreshConnectionStatus",
          "when": "view == xinghan.connectionStatusView",
          "group": "navigation"
        },
        {
          "command": "xinghan.refreshDeviceFiles",
          "when": "view == xinghan.deviceFilesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "xinghan.renameDeviceFileFromTree",
          "when": "view == xinghan.deviceFilesView && viewItem == 'deviceFile'",
          "group": "0_deviceFile@1"
        },
        {
          "command": "xinghan.deleteFileFromTree",
          "when": "view == xinghan.deviceFilesView && viewItem == 'deviceFile'",
          "group": "0_deviceFile@2"
        },
        {
          "command": "xinghan.copyConnectionDeviceId",
          "when": "view == xinghan.connectionStatusView && viewItem == 'connectionPort'",
          "group": "0_connection@1"
        },
        {
          "command": "xinghan.copyConnectionPort",
          "when": "view == xinghan.connectionStatusView && viewItem == 'connectionPort'",
          "group": "0_connection@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "xinghan.submenu",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "0_xinghan.ctx"
        }
      ],
      "editor/context": [
        {
          "submenu": "xinghan.submenu",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "0_xinghan.ctx"
        }
      ],
      "xinghan.submenu": [
        {
          "command": "xinghan.runOnDevice",
          "group": "1_run@1"
        },
        {
          "command": "xinghan.stopRunOnDevice",
          "group": "1_run@2"
        },
        {
          "command": "xinghan.upload",
          "group": "2_upload@1"
        },
        {
          "command": "xinghan.uploadAndRun",
          "group": "2_upload@2"
        }
      ],
      "commandPalette": [
        {
          "command": "xinghan.runOnDevice",
          "when": "false"
        },
        {
          "command": "xinghan.stopRunOnDevice",
          "when": "false"
        },
        {
          "command": "xinghan.toggleRunOnDevice",
          "when": "false"
        },
        {
          "command": "xinghan.upload",
          "when": "false"
        },
        {
          "command": "xinghan.uploadAndRun",
          "when": "false"
        },
        {
          "command": "xinghan.connectBluetooth",
          "when": "false"
        },
        {
          "command": "xinghan.toggleBluetooth",
          "when": "false"
        },
        {
          "command": "xinghan.disconnectBluetooth",
          "when": "false"
        },
        {
          "command": "xinghan.deleteFileFromTree",
          "when": "false"
        },
        {
          "command": "xinghan.disconnectRepl",
          "when": "false"
        },
        {
          "command": "xinghan.toggleRepl",
          "when": "false"
        },
        {
          "command": "xinghan.refreshConnectionStatus",
          "when": "false"
        },
        {
          "command": "xinghan.refreshDeviceFiles",
          "when": "false"
        },
        {
          "command": "xinghan.copyConnectionDeviceId",
          "when": "false"
        },
        {
          "command": "xinghan.copyConnectionPort",
          "when": "false"
        },
        {
          "command": "xinghan.openDeviceFile",
          "when": "false"
        },
        {
          "command": "xinghan.deleteFile",
          "when": "false"
        },
        {
          "command": "xinghan.connectWifi",
          "when": "false"
        },
        {
          "command": "xinghan.selectPortAndRepl",
          "when": "false"
        },
        {
          "command": "xinghan.renameDeviceFileFromTree",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xinghan-sidebar",
          "title": "星瀚助手",
          "icon": "logo.png"
        }
      ]
    },
    "views": {
      "xinghan-sidebar": [
        {
          "id": "xinghan.actionsView",
          "name": "星瀚助手"
        },
        {
          "id": "xinghan.deviceFilesView",
          "name": "星瀚控制器"
        },
        {
          "id": "xinghan.connectionStatusView",
          "name": "连接状态"
        }
      ]
    },
    "configuration": {
      "title": "星瀚助手",
      "properties": {
        "xinghan.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "用于执行上传脚本的 Python 解释器（如 python3、python 或完整路径）。"
        },
        "xinghan.serialPort": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "指定串口（如 /dev/cu.usbmodem123、COM3）。留空则由脚本自动检测。"
        },
        "xinghan.bluetoothNamePrefix": {
          "type": "string",
          "default": "ybc-r2",
          "description": "扫描蓝牙设备时使用的名称前缀；留空则显示扫描到的所有 BLE 设备。"
        },
        "xinghan.bluetoothScanTimeout": {
          "type": "number",
          "default": 6,
          "description": "蓝牙扫描超时时间（秒）。"
        },
        "xinghan.bluetoothCommandTimeout": {
          "type": "number",
          "default": 8,
          "description": "蓝牙 NUS 命令等待设备响应的超时时间（秒）。"
        },
        "xinghan.bluetoothRunContainer": {
          "type": "string",
          "default": "container1",
          "description": "通过蓝牙运行当前文件时，用于临时上传运行脚本的容器。"
        },
        "xinghan.wifiPresets": {
          "type": "array",
          "default": [
            {
              "name": "xuchang",
              "password": "00000000",
              "authMode": 3
            },
            {
              "name": "YBC",
              "password": "YBC123456@@",
              "authMode": 3
            },
            {
              "name": "XC的iPhone",
              "password": "79798080",
              "authMode": 3
            }
          ],
          "description": "预设的常用 WiFi 列表。每项包含 name（WiFi名）、password（密码）、authMode（认证模式，默认3）。",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "WiFi 名称"
              },
              "password": {
                "type": "string",
                "description": "WiFi 密码"
              },
              "authMode": {
                "type": "number",
                "default": 3,
                "description": "认证模式"
              }
            },
            "required": [
              "name",
              "password"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "package": "npx @vscode/vsce package --allow-missing-repository --skip-license",
    "publish:openvsx": "npx ovsx publish --no-dependencies"
  },
  "dependencies": {
    "tree-kill": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.0.0"
  }
}
